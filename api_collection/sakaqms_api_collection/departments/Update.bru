meta {
  name: Update department
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/departments/{{departmentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "deptName": "Updated Department",
    "manager": "Jane Doe",
    "modifiedBy": "admin",
    "modifiedOn": "2026-09-13T00:00:00",
    "authorisedBy": "admin"
  }
}
