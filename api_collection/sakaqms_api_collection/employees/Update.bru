meta {
  name: Update employee
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/employees/{{employeeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "employeeName": "Updated Employee",
    "username": "{{username}}",
    "isAdmin": false,
    "modifiedBy": "admin",
    "modifiedOn": "2026-09-13T00:00:00",
    "authorisedBy": "admin",
    "departments": []
  }
}
