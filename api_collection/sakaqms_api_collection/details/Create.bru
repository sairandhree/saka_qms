meta {
  name: Create detail
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/details
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "details": "New detail",
    "note": "Detail note",
    "parameters": "Parameter values",
    "relatedItemId": {{itemId}},
    "link": "https://example.com",
    "sequence": 1,
    "passward": "example"
  }
}
